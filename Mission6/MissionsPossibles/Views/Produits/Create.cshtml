@model Mission.ViewModels.Produit_VM

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Produit</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Produit.Description" class="control-label"></label>
                <input asp-for="Produit.Description" class="form-control" />
                <span asp-validation-for="Produit.Description" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Produit.DateCreation" class="control-label"></label>
                <input asp-for="Produit.DateCreation" class="form-control" />
                <span asp-validation-for="Produit.DateCreation" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Produit.PrixVente" class="control-label"></label>
                <input asp-for="Produit.PrixVente" class="form-control" />
                <span asp-validation-for="Produit.PrixVente" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Produit.CategorieId" class="control-label"></label>
                <!-- Remplacement de ViewBag par Model.CategorieList -->
                <select asp-for="Produit.CategorieId" class="form-control" asp-items="Model.CategorieList">
                    <option value="">-- Sélectionner une catégorie --</option>
                </select>
                <span asp-validation-for="Produit.CategorieId" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
